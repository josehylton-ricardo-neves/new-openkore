        . '[Console]::Beep(3500,700);'
        . 'Start-Sleep -Milliseconds 1;'
        . '[Console]::Beep(3500,700);'
        . 'Start-Sleep -Milliseconds 1;'
        . '[Console]::Beep(3500,700);'
        . 'Start-Sleep -Milliseconds 1;'
        . '[Console]::Beep(3500,700);'
        . 'Start-Sleep -Milliseconds 1;'
        . '[Console]::Beep(3500,700);'
        . 'Start-Sleep -Milliseconds 1;'
        . '[Console]::Beep(3500,700);'
        . 'Start-Sleep -Milliseconds 1;'
        . '[Console]::Beep(3500,700);'
        . 'Start-Sleep -Milliseconds 1;'
        . '[Console]::Beep(3500,700);'
        . 'Start-Sleep -Milliseconds 1;'
        . '[Console]::Beep(3500,700);'
        . 'Start-Sleep -Milliseconds 1;'
        . '[Console]::Beep(3500,700);'
        . 'Start-Sleep -Milliseconds 1;'
        . '[Console]::Beep(3500,700);';

    my $cmd =
        'start "" powershell.exe '
      . '-NoProfile '
      . '-WindowStyle Hidden '
      . '-Command "'
      . $ps
      . '"';

    system(
        'cmd.exe',
        '/c',
        $cmd
    );
}



sub on_pacr {
    my (undef, $args) = @_;

    my $len     = $args->{len}     // 0;
    my $magic   = $args->{magic}   // '';
    my $type    = $args->{type}    // 0;
    my $payload = $args->{payload} // '';

    unless ($magic eq 'PACR') {
        warning sprintf(
            "[PACR] 7FF3 com magic invalido: %s\n",
            unpack('H*', $magic)
        );
        return;
    }

    message sprintf(
        "[PACR] 7FF3 recebido: len=%u type=%u\n",
        $len,
        $type
    ), 'success';


    # ==========================================================
    # TYPE 1 - challenge
    # Total observado: 95 bytes
    # ==========================================================

    if ($type == 1) {

		unless ($len == 95 && length($payload) == 85) {
			warning sprintf(
				"[PACR] Challenge inesperado: len=%u payload=%u\n",
				$len,
				length($payload)
			);
			return;
		}

		# 4 campos iniciais + 9 IDs = 13 uint32
		my @v = unpack(
			'V13',
			substr($payload, 0, 52)
		);

		my $challenge_id = $v[0];
		my $timeout      = $v[1];
		my $flags        = $v[2];
		my $attempts     = $v[3];

		my @ids = @v[4 .. 12];

		my $target  = $ids[0];
		my @options = @ids[1 .. 8];

		my $token = unpack(
			'Z33',
			substr($payload, 52, 33)
		);


		# ==========================================================
		# ALERTA SONORO
		#
		# Evita tocar duas vezes caso o mesmo challenge seja
		# entregue novamente por algum motivo.
		# ==========================================================

		#if (
		#	!defined($last_alarm_challenge)
		#	|| $last_alarm_challenge != $challenge_id
		#) {
		#	$last_alarm_challenge = $challenge_id;
		#	captcha_alarm();
		#}
		
		
		
		captcha_alarm();
		


		# Guarda o challenge atual para o comando "pacr"
		$current = {
			challenge_id => $challenge_id,
			timeout      => $timeout,
			flags        => $flags,
			attempts     => $attempts,
			target       => $target,
			options      => \@options,
			token        => $token,
			answered     => 0,
		};


		# ==========================================================
		# MOSTRA NO CONSOLE
		# ==========================================================

		message "\n";
		message "========== CAPTCHA PACR ==========\n", 'success';

		message sprintf(
			"opcode    = 0x%04X\n",
			0x7FF3
		);

		message sprintf(
			"length    = %u\n",
			$len
		);

		message sprintf(
			"magic     = %s\n",
			$magic
		);

		message sprintf(
			"type      = %u\n\n",
			$type
		);

		message sprintf(
			"challenge = %u\n",
			$challenge_id
		);

		message sprintf(
			"timeout   = %u\n",
			$timeout
		);

		message sprintf(
			"flags     = %u\n",
			$flags
		);

		message sprintf(
			"attempts  = %u\n",
			$attempts
		);

		message sprintf(
			"target    = %u\n\n",
			$target
		);

		message "options:\n";

		for my $i (0 .. $#options) {
			message sprintf(
				"  %d -> %u\n",
				$i + 1,
				$options[$i]
			);
		}

		message sprintf(
			"\ntoken = %s\n",
			$token
		);

		message "\nPara responder: pacr <1-8>\n";
		message "==================================\n\n";

		return;
	}


    # ==========================================================
    # TYPE 2 - resultado
    # Total observado: 18 bytes
    # ==========================================================

    if ($type == 2) {

        unless ($len == 18 && length($payload) >= 8) {
            warning sprintf(
                "[PACR] Resultado inesperado: len=%u payload=%u\n",
                $len,
                length($payload)
            );
            return;
        }

        my (
            $challenge_id,
            $result,
            $flags,
            $reserved
        ) = unpack(
            'V v C C',
            substr($payload, 0, 8)
        );

        message sprintf(
            "[PACR] RESULT challenge=%u result=%u flags=%u reserved=%u\n",
            $challenge_id,
            $result,
            $flags,
            $reserved
        ), 'success';

        if (
            $current
            && $current->{challenge_id} == $challenge_id
        ) {
            undef $current;
        }

        return;
    }


    # ==========================================================
    # TYPE 3 - reconhecido pela DLL
    # Total = 10 bytes
    # ==========================================================

    if ($type == 3) {

        message "[PACR] TYPE 3 recebido. Limpando challenge atual.\n";

        undef $current;

        return;
    }


    warning sprintf(
        "[PACR] Type desconhecido: %u len=%u payload=%s\n",
        $type,
        $len,
        unpack('H*', $payload)
    );
}


sub show_current {

    unless ($current) {
        message "[PACR] Nenhum challenge ativo.\n";
        return;
    }

    message "\n";
    message "================ PACR ATUAL ====================\n";

    message sprintf(
        "Challenge ID : %u\n",
        $current->{challenge_id}
    );

    message sprintf(
        "Timeout      : %u\n",
        $current->{timeout}
    );

    message sprintf(
        "Tentativas   : %u\n",
        $current->{attempts}
    );

    message sprintf(
        "Target ID    : %u\n",
        $current->{target}
    );

    message "\nOpcoes:\n";

    for my $i (0 .. 7) {

        message sprintf(
            "  %d -> %u\n",
            $i + 1,
            $current->{options}[$i]
        );
    }

    message sprintf(
        "\nRespondido: %s\n",
        $current->{answered} ? 'sim' : 'nao'
    );

    message "================================================\n";
}


sub cmd_pacr {
    my (undef, $args) = @_;

    $args //= '';

    $args =~ s/^\s+//;
    $args =~ s/\s+$//;


    # pacr
    if ($args eq '') {
        show_current();
        return;
    }


    # pacr clear
    if (lc($args) eq 'clear') {
        undef $current;
        message "[PACR] Estado local limpo.\n";
        return;
    }


    # pacr 1 .. pacr 8
    unless ($args =~ /^([1-8])$/) {

        message(
            "[PACR] Uso: pacr | pacr <1-8> | pacr clear\n"
        );

        return;
    }


    unless ($current) {
        warning "[PACR] Nenhum challenge ativo.\n";
        return;
    }


    if ($current->{answered}) {

        warning(
            "[PACR] Esse challenge ja recebeu uma resposta. "
          . "Aguarde o resultado do servidor.\n"
        );

        return;
    }


    my $choice = int($1);

    my $selected_item_id =
        $current->{options}[ $choice - 1 ];


    my $token = $current->{token};

    unless (defined $token && length($token) == 32) {

        warning sprintf(
            "[PACR] Token invalido. Comprimento=%d\n",
            defined($token) ? length($token) : -1
        );

        return;
    }


    # ----------------------------------------------------------
    # Estrutura observada no cliente oficial:
    #
    # v   opcode          = 0x7FF3
    # v   length          = 51
    # a4  magic           = PACR
    # v   type            = 1
    # V   challenge_id
    # V   selectedItemId
    # Z33 token
    # ----------------------------------------------------------

    my $msg = pack(
        'v v a4 v V V Z33',
        0x7FF3,
        51,
        'PACR',
        1,
        $current->{challenge_id},
        $selected_item_id,
        $token
    );


    unless (length($msg) == 51) {

        warning sprintf(
            "[PACR] ERRO: pacote construido com %d bytes em vez de 51.\n",
            length($msg)
        );

        return;
    }


    message sprintf(
        "[PACR] Enviando escolha manual %d -> itemID=%u challenge=%u\n",
        $choice,
        $selected_item_id,
        $current->{challenge_id}
    ), 'success';


    message sprintf(
        "[PACR] RAW=%s\n",
        unpack('H*', $msg)
    );


    $messageSender->sendToServer($msg);

    $current->{answered} = 1;
}



sub cmd_pacrtest {
    message "\n[PACR TEST] Simulando challenge capturado no Wireshark...\n", 'success';

    my @ids = (
        4003,   # target
        517,
        4013,
        503,
        506,
        4009,
        513,
        4003,
        504,
    );

    my $payload = pack(
        'V13 Z33',
        187,        # challenge_id
        60,         # timeout
        0,          # flags
        3,          # attempts

        @ids,

        '69492b75d24059d558b4e63273650912'
    );

    message sprintf(
        "[PACR TEST] payload=%d bytes\n",
        length($payload)
    );

    my %args = (
        len     => 95,
        magic   => 'PACR',
        type    => 1,
        payload => $payload,
    );

    on_pacr(
        undef,
        \%args
    );
}




sub cmd_pacrbuild {
    my (undef, $args) = @_;

    $args //= '';
    $args =~ s/^\s+//;
    $args =~ s/\s+$//;

    unless ($args =~ /^([1-8])$/) {
        warning "[PACR] Uso: pacrbuild <1-8>\n";
        return;
    }

    unless ($current) {
        warning "[PACR] Nenhum challenge ativo.\n";
        return;
    }

    my $choice = int($1);

    my $selected_item_id =
        $current->{options}[ $choice - 1 ];

    my $msg = pack(
        'v v a4 v V V Z33',
        0x7FF3,
        51,
        'PACR',
        1,
        $current->{challenge_id},
        $selected_item_id,
        $current->{token}
    );

    message "\n========== PACR BUILD TEST ==========\n", 'success';

    message sprintf(
        "choice           = %d\n",
        $choice
    );

    message sprintf(
        "challenge        = %u\n",
        $current->{challenge_id}
    );

    message sprintf(
        "selected_item_id = %u\n",
        $selected_item_id
    );

    message sprintf(
        "length           = %u\n",
        length($msg)
    );

    message sprintf(
        "hex              = %s\n",
        unpack('H*', $msg)
    );

    message "NAO FOI ENVIADO AO SERVIDOR.\n";
    message "=====================================\n\n";
}




sub unload {

    Plugins::delHooks($hooks);

    Commands::unregister($commands)
        if $commands;

    undef $current;

    message "[PACR] Plugin descarregado.\n";
}

1;