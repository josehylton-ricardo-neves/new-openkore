sub new {
	my ($class) = @_;
	my $self = $class->SUPER::new(@_);

	my %packets = (
		'007D' => ['map_loaded'],
		'014D' => ['guild_check'],
		'014F' => ['guild_info_request', 'V', [qw(type)]],
		'021D' => ['less_effect', 'V', [qw(flag)]],
		'0447' => ['blocking_play_cancel'],
		#'083C' => ['actor_action', 'a4 C', [qw(targetID type)]],
		'0437' => ['actor_action', 'a4 C', [qw(targetID type)]],
		'035F' => ['character_move', 'a3', [qw(coords)]],
		#'0866' => ['sync', 'V', [qw(time)]],
		'0360' => ['sync', 'V', [qw(time)]],
		'0361' => ['actor_look_at', 'v C', [qw(head body)]],
		'08C9' => ['request_cashitems'],
		'0936' => ['actor_info_request', 'a4', [qw(ID)]],
		#'0944' => ['map_login', 'a4 a4 a4 V C', [qw(accountID charID sessionID tick sex)]],
		'0436' => ['map_login', 'a4 a4 a4 V V C', [qw(accountID charID sessionID unknown tick sex)]],
	);
	$self->{packet_list}{$_} = $packets{$_} for keys %packets;

	my %handlers = qw(
		map_loaded 007D
		guild_check 014D
		guild_info_request 014F
		less_effect 021D
		character_move      035F
		actor_look_at       0361
		blocking_play_cancel 0447
		actor_action 0437
		sync 0360
		request_cashitems 08C9
		actor_info_request 0936
		map_login 0436
	);
	$self->{packet_lut}{$_} = $handlers{$_} for keys %handlers;

	$self->{oro_map_loaded_count} = 0;
	$self->{oro_bootstrap_sent} = 0;

	return $self;
}

sub _oro_send_raw {
	my ($self, $label, $msg) = @_;
	#message "ThanatosRO SEND $label len=" . length($msg) . " hex=" . unpack('H*', $msg) . "\n", 'sendPacket';
	
	$self->sendToServer($msg);
}

# Do not use reconstruct() here: the external packet-length table in this
# installation can truncate shuffled packets to two bytes.
sub sendMapLogin {
	my ($self, $accountID, $charID, $sessionID, $sex) = @_;
	$sex = 0 if !defined($sex) || $sex < 0 || $sex > 1;

	my $msg = pack(
		'v a4 a4 a4 V V C',
		#0x0944,
		0x0436,
		$accountID,
		$charID,
		$sessionID,
		0,
		getTickCount(),
		$sex
	);

	die "Invalid ThanatosRO map_login size: " . length($msg)
		#unless length($msg) == 19;
		unless length($msg) == 23;

	$self->_oro_send_raw('0436 map_login', $msg);
}

# The official client sends 021D immediately before each 007D.
# On the second map-loaded notification it also sends a second 0866.
sub sendMapLoaded {
	my ($self) = @_;
	$self->{oro_map_loaded_count}++;

	$self->_oro_send_raw('021D less_effect(0)', pack('vV', 0x021D, 0));
	$self->_oro_send_raw('007D map_loaded', pack('v', 0x007D));
	
	
	#message "[ThanatosRO] Disparando packet/sendMapLoaded apos 007D\n";

	# 3. Avisa os plugins que o 007D acabou de ser enviado.
	Plugins::callHook('packet/sendMapLoaded', {sender => $self, count  => $self->{oro_map_loaded_count},} );
	
	#message "[ThanatosRO] packet/sendMapLoaded terminou\n";


	if ($self->{oro_map_loaded_count} >= 2) {
		$self->sendSync(1);
	}
}

sub sendSync {
	my ($self, $initialSync) = @_;
	
	#my $msg = pack('vV', 0x0866, getTickCount());
	my $msg = pack('vV', 0x0360, getTickCount());
	
	die "Invalid ThanatosRO sync size: " . length($msg)
		unless length($msg) == 6;
	
	#$self->_oro_send_raw('0866 sync', pack('vV', 0x0866, getTickCount()));
	
	#message "[ThanatosRO] 0360 sync raw=" . unpack('H*', $msg) . "\n";
	
	$self->sendToServer($msg);
}

# Official bootstrap sequence: 08C9, 014D, 014F(0), 014F(4),
# 014F(0), 014F(1).
sub sendGuildRequestInfo {
	my ($self, $page) = @_;

	if (!$self->{oro_bootstrap_sent}) {
		$self->{oro_bootstrap_sent} = 1;
		$self->_oro_send_raw('08C9 request_cashitems', pack('v', 0x08C9));
		$self->_oro_send_raw('014D guild_check', pack('v', 0x014D));
		for my $type (0, 4, 0, 1) {
			$self->_oro_send_raw("014F guild_info_request($type)", pack('vV', 0x014F, $type));
		}
		return;
	}

	$self->_oro_send_raw("014F guild_info_request($page)", pack('vV', 0x014F, $page));
}

