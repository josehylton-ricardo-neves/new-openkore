# Confirmed from ThanatosRO_storage.pcapng - 2026-09-20:
#   0364 + inventory index (a2) + amount (V), 8 bytes total.
#
# Example:
#   64 03 13 00 01 00 00 00
#   opcode = 0364
#   inventory index = 0x0013
#   amount = 1
sub sendStorageAdd {
	my ($self, $ID, $amount) = @_;

	# This capture confirms only the normal personal Kafra storage packet.
	# Preserve the inherited behavior for guild storage until it is captured.
	if (($Globals::config{storageAuto_type} || 0) == 1) {
		warning "ThanatosRO guild_storage_item_add is not confirmed; using inherited sender.\n";
		return $self->SUPER::sendStorageAdd($ID, $amount);
	}

	my $id_len = defined($ID) ? length($ID) : -1;
	unless (defined($ID) && $id_len == 2) {
		warning "ThanatosRO SUPPRESSED storage_item_add: invalid inventory ID length=$id_len\n";
		return;
	}

	$amount = defined($amount) ? int($amount) : 0;
	if ($amount <= 0) {
		warning "ThanatosRO SUPPRESSED storage_item_add: invalid amount=$amount\n";
		return;
	}

	#my $msg = pack('v a2 V', 0x0879, $ID, $amount);
	#die "Invalid ThanatosRO storage_item_add size: " . length($msg)
	#	unless length($msg) == 8;
	#
	#$self->_oro_send_raw(
	#	"0879 storage_item_add ID=" . unpack('H*', $ID) . " amount=$amount",
	#	$msg
	#);
	
	
	
	my $msg = pack('v a2 V', 0x0364, $ID, $amount);
	die "Invalid ThanatosRO storage_item_add size: " . length($msg)
		unless length($msg) == 8;

	$self->_oro_send_raw(
		"0364 storage_item_add ID=" . unpack('H*', $ID) . " amount=$amount",
		$msg
	);
	
}


# Confirmed from oro_cliente_storage_get.pcapng:
#   023B + storage index (a2) + amount (V), 8 bytes total.
# Example captured from the official client:
#   3B 02 15 00 24 00 00 00
#   opcode=023B, index=21, amount=36.
#
# openkore_storage_get.pcapng showed the inherited reconstruct() path sending
# only "3B 02" (2 bytes), so this method bypasses reconstruct() exactly like
# sendStorageAdd() does for shuffled packet 0879.
sub sendStorageGet {
	my ($self, $ID, $amount) = @_;

	# Only normal personal Kafra storage was confirmed in the capture.
	# Preserve inherited behavior for guild storage until it is captured.
	if (($Globals::config{storageAuto_type} || 0) == 1) {
		warning "ThanatosRO guild_storage_item_remove is not confirmed; using inherited sender.\n";
		return $self->SUPER::sendStorageGet($ID, $amount);
	}

	my $id_len = defined($ID) ? length($ID) : -1;
	unless (defined($ID) && $id_len == 2) {
		warning "ThanatosRO SUPPRESSED storage_item_remove: invalid storage ID length=$id_len\n";
		return;
	}

	$amount = defined($amount) ? int($amount) : 0;
	if ($amount <= 0) {
		warning "ThanatosRO SUPPRESSED storage_item_remove: invalid amount=$amount\n";
		return;
	}

	my $msg = pack('v a2 V', 0x023B, $ID, $amount);
	die "Invalid ThanatosRO storage_item_remove size: " . length($msg)
		unless length($msg) == 8;

	$self->_oro_send_raw(
		"023B storage_item_remove index=" . unpack('v', $ID) .
		" ID=" . unpack('H*', $ID) .
		" amount=$amount",
		$msg
	);
}



sub sendDrop {
    my ($self, $ID, $amount) = @_;

    my $id_len = defined($ID) ? length($ID) : -1;
    unless (defined($ID) && $id_len == 2) {
        warning "ThanatosRO SUPPRESSED item_drop: invalid inventory ID length=$id_len\n";
        return;
    }

    $amount = defined($amount) ? int($amount) : 0;
    if ($amount <= 0 || $amount > 0xFFFF) {
        warning "ThanatosRO SUPPRESSED item_drop: invalid amount=$amount\n";
        return;
    }

    my $msg = pack('v a2 v', 0x0367, $ID, $amount);

    die "Invalid ThanatosRO item_drop size: " . length($msg)
        unless length($msg) == 6;

    $self->_oro_send_raw(
        "0367 item_drop index=" . unpack('v', $ID) .
        " ID=" . unpack('H*', $ID) .
        " amount=$amount",
        $msg
    );
}

