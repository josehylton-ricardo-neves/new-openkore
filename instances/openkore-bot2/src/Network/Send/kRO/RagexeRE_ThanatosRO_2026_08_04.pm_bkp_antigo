# Confirmed actor_action layout:
#   083C 00000000 02 = sit
#   083C 00000000 03 = stand
#   083C <actorID> 07 = continuous attack
sub sendAction {
	my ($self, $targetID, $type) = @_;

	$type = -1 unless defined $type;
	my $defined = defined($targetID) ? 1 : 0;
	my $length = $defined ? length($targetID) : -1;
	my $hex = ($defined && $length > 0) ? unpack('H*', $targetID) : '<none>';

	#message "ThanatosRO sendAction type=$type target_defined=$defined target_len=$length target_hex=$hex\n", 'sendPacket';

	my %args = (
		monID => $targetID,
		flag  => $type,
	);

	Plugins::callHook('packet_pre/sendAttack', \%args)
		if $type == 0 || $type == 7;
	Plugins::callHook('packet_pre/sendSit', \%args)
		if $type == 2 || $type == 3;

	if ($args{return}) {
		$self->sendToServer($args{msg}) if defined $args{msg};
		return;
	}

	$targetID = $args{monID};
	$type = $args{flag};

	# OpenKore calls sendAction('0', 2/3) for sit/stand. The textual "0"
	# is not the wire ID. The official client sends four binary zero bytes.
	if ($type == 2 || $type == 3) {
		my $msg = pack('v V C', 0x083C, 0, $type);
		die "Invalid ThanatosRO sit/stand actor_action size: " . length($msg)
			unless length($msg) == 7;

		#$self->_oro_send_raw("083C actor_action target=00000000 type=$type", $msg);
		
		#message("[ThanatosRO] 083C raw=" . unpack('H*', $msg) . "\n");
		
		$self->sendToServer($msg);
		return;
	}

	unless ($type == 0 || $type == 7) {
		warning "ThanatosRO SUPPRESSED actor_action unknown type=$type\n";
		return;
	}

	unless (defined($targetID) && length($targetID) == 4) {
		my $bad_len = defined($targetID) ? length($targetID) : -1;
		warning "ThanatosRO SUPPRESSED actor_action attack: invalid target len=$bad_len\n";
		return;
	}
	
	my $msg = pack(
    'v a4 C',
    0x0437,
    $targetID,
    $type
	);

	die "Invalid ThanatosRO actor_action size: " . length($msg)
		unless length($msg) == 7;

	#message("[ThanatosRO] SEND 0437 actor_action target=" . unpack('H*', $targetID) . " type=$type raw=" . unpack('H*', $msg) . );

	$self->sendToServer($msg);

	return;
	
	
	

	#my $msg = pack('v a4 C', 0x083C, $targetID, $type);
	#die "Invalid ThanatosRO actor_action size: " . length($msg)
	#	unless length($msg) == 7;
	
	#message("[ThanatosRO] 083C raw=" . unpack('H*', $msg) . "\n");
	
	#$self->sendToServer($msg);
	
	
	# TESTE TEMPORARIO:
	# tipo 0/7 = tentativa de ataque normal.
	# Nao enviar ate confirmarmos se 083C realmente e o opcode correto
	# para ataque normal neste cliente ThanatosRO.
	#if ($type == 0 || $type == 7) {
	#	message(
	#		"[ThanatosRO] TESTE ataque normal SUPRIMIDO target=" .
	#		unpack('H*', $targetID) .
	#		" type=$type\n"
	#	);
	#
	#	return;
	#}
	
	
}


