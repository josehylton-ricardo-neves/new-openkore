# Only send item_take for an ID that was actually observed in an 084B
# item_appeared packet. This prevents binIDs or small numeric indexes from
# being transmitted as ground-item IDs.
sub sendTake {
	my ($self, $itemID) = @_;

	my $len = defined($itemID) ? length($itemID) : -1;
	my $hex = (defined($itemID) && $len > 0) ? unpack('H*', $itemID) : '<undefined>';
	#message "ThanatosRO sendTake requested ID=$hex len=$len\n", 'sendPacket';

	unless (defined($itemID) && length($itemID) == 4) {
		warning "ThanatosRO SUPPRESSED item_take: invalid ID length=$len\n";
		return;
	}

	unless (exists $Network::Receive::kRO::RagexeRE_ThanatosRO_2026_08_04::ORO_GROUND_ITEM_IDS{$itemID}) {
		warning "ThanatosRO SUPPRESSED item_take: ID=$hex was not observed in item_appeared\n";
		return;
	}

	my $msg = pack('v a4', 0x08AD, $itemID);
	die "Invalid ThanatosRO item_take size: " . length($msg)
		unless length($msg) == 6;

	$self->_oro_send_raw("08AD item_take ID=$hex", $msg);
}


