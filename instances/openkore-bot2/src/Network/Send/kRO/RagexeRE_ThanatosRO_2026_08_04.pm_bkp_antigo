# ThanatosRO atual:
#   035F + 3-byte packed coordinates = character_move
sub sendMove {
	my ($self, $x, $y) = @_;

	my %args = (
		x => $x,
		y => $y,
	);

	$self->reconstruct_character_move(\%args);
	my $coords = $args{coords};

	unless (defined($coords) && length($coords) == 3) {
		my $len = defined($coords) ? length($coords) : -1;
		warning "ThanatosRO SUPPRESSED character_move: invalid coord length=$len x=$x y=$y\n";
		return;
	}

	my $msg = pack('v a3', 0x035F, $coords);

	die "Invalid ThanatosRO character_move size: " . length($msg)
		unless length($msg) == 5;

	#message("[ThanatosRO] 035F character_move x=$x y=$y coords=" . unpack('H*', $coords) . " raw=" . unpack('H*', $msg) . "\n");

	$self->sendToServer($msg);
}











