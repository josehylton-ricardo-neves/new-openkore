# ------------------------------------------------------------
# CONFIG / HELPERS
# ------------------------------------------------------------

sub cfg {
    my ($key, $default) = @_;
    return $default if !exists $config{$key};
    return $default if !defined $config{$key};
    return $default if $config{$key} eq '';
    return $config{$key};
}

sub enabled {
    return cfg('nqKnight_enabled', 1) ? 1 : 0;
}

sub normalizeMap {
    my ($m) = @_;
    $m //= '';
    $m =~ s/\.gat$//i;
    return $m;
}

sub currentMap {
    return '' unless $field;
    return normalizeMap($field->baseName);
}

sub saveMap { return normalizeMap(cfg('nqKnight_saveMap', 'geffen')); }
sub npcMap  { return normalizeMap(cfg('nqKnight_npcMap', 'nif_fild01')); }
sub huntMap { return normalizeMap(cfg('nqKnight_huntMap', 'nif_fild02')); }
sub questID { return int(cfg('nqKnight_questID', 60176)); }

sub questStatus {
    my $id = questID();
    return 'inactive' unless $questList && exists $questList->{$id};

    my $q = $questList->{$id};
    return 'inactive' unless $q && $q->{active};

    my $missions = $q->{missions} || {};
    for my $m (values %$missions) {
        next unless $m;
        my $goal  = $m->{mob_goal}  || 0;
        my $count = $m->{mob_count} || 0;

        if ($goal > 0) {
            return 'incomplete' if $count < $goal;
        } else {
            return 'incomplete' if $count == 0;
        }
    }

    return 'complete';
}

sub peerQuest {
    my $ttl = cfg('nqKnight_peerStatusTTL', 15);
    return 'unknown' if !$peerQuestAt || (time - $peerQuestAt) > $ttl;
    return $peerQuest;
}

sub inNiflheimCorridor {
    my $m = currentMap();
    return 1 if $m eq npcMap();
    return 1 if $m eq huntMap();
    return 1 if $m eq 'yggdrasil01';
    return 1 if $m eq 'um_dun01';
    return 1 if $m eq 'um_dun02';
    return 0;
}

sub pairDesiredState {
    my $own  = questStatus();
    my $peer = peerQuest();
    return '' if $peer eq 'unknown';

    return 'QUEST_RETURN'
        if $own eq 'complete' && $peer eq 'complete';

    return 'QUEST_PICKUP'
        if $own eq 'inactive' || $peer eq 'inactive';

    return 'NORMAL';
}

sub partyMemberByName {
    my ($wanted) = @_;
    return unless $char && $char->{party} && $char->{party}{users};
    return unless defined $wanted && $wanted ne '';

    for my $ID (keys %{$char->{party}{users}}) {
        next if defined $accountID && $ID eq $accountID;
        my $m = $char->{party}{users}{$ID};
        next unless $m && defined $m->{name};
        return ($ID, $m) if lc($m->{name}) eq lc($wanted);
    }

    return;
}

sub priestMember {
    return partyMemberByName(cfg('nqKnight_priestName', 'Curador'));
}

sub memberMap {
    my ($m) = @_;
    return '' unless $m;
    return normalizeMap($m->{map});
}

#sub memberPos {
#    my ($m) = @_;
#    return unless $m && $m->{pos};
#    return unless defined $m->{pos}{x} && defined $m->{pos}{y};
#    return if $m->{pos}{x} >= 65535 || $m->{pos}{y} >= 65535;
#    return {x => $m->{pos}{x}, y => $m->{pos}{y}};
#}


sub memberPos {
    my ($m) = @_;
    return unless $m;

    # 1) Primeiro tenta a posicao recebida pela estrutura da party.
    if ($m->{pos}
        && defined $m->{pos}{x}
        && defined $m->{pos}{y}
        && $m->{pos}{x} < 65535
        && $m->{pos}{y} < 65535) {

        return {
            x => $m->{pos}{x},
            y => $m->{pos}{y}
        };
    }

    # 2) Fallback: se o membro estiver visivel na tela,
    # usa a posicao REAL do Actor em playersList.
    if ($playersList && defined $m->{name} && $m->{name} ne '') {
        for my $a (@{$playersList->getItems()}) {
            next unless $a;
            next unless defined $a->{name};
            next unless lc($a->{name}) eq lc($m->{name});

            my $p = $a->{pos_to} || $a->{pos};
            next unless $p;
            next unless defined $p->{x} && defined $p->{y};
            next if $p->{x} >= 65535 || $p->{y} >= 65535;

            return {
                x => $p->{x},
                y => $p->{y}
            };
        }
    }

    return;
}

sub memberDead {
    my ($ID, $m) = @_;
    return 0 unless $m;

    if ($playersList) {
        my $a = $playersList->getByID($ID);
        return 1 if $a && $a->{dead};
    }

    return 1 if $m->{dead};
    return 1 if defined $m->{hp} && defined $m->{hp_max}
             && $m->{hp_max} > 0 && $m->{hp} <= 0;
    return 0;
}

sub blockDist {
    my ($a, $b) = @_;
    return 99999 unless $a && $b;
    my $dx = abs(($a->{x} // 0) - ($b->{x} // 0));
    my $dy = abs(($a->{y} // 0) - ($b->{y} // 0));
    return $dx > $dy ? $dx : $dy;
}

sub sendParty {
    my ($msg) = @_;
    return unless $char && $char->{party};
    Commands::run("p [NQ] $msg");
}

sub broadcastStatus {
    my ($force) = @_;
    my $sig = join('|', questStatus(), $state, $phase, currentMap());
    my $hb = cfg('nqKnight_statusHeartbeat', 5);

    return if !$force && $sig eq $lastStatusSig
        && (time - $lastStatus) < $hb;

    sendParty("STATUS K " . questStatus());
    $lastStatusSig = $sig;
    $lastStatus = time;
}

sub saveConfig {
    my ($key) = @_;
    return if exists $savedConfig{$key};
    $savedConfig{$key} = exists $config{$key} ? $config{$key} : undef;
}

sub setConfig {
    my ($key, $value) = @_;
    saveConfig($key);
    $config{$key} = $value;
}

sub applyBaseConfig {
    return if $configApplied;

    setConfig('follow', 0);
    setConfig('route_randomWalk', 0);
    setConfig('teleportAuto_minAggressives', 0);
	
	
	# Nao teleportar simplesmente porque perdeu/abandonou um alvo.
    setConfig('teleportAuto_dropTarget', 0);
    setConfig('teleportAuto_dropTargetEngaged', 0);
    setConfig('teleportAuto_lostTarget', 0);
	

    # Knight e o tanque da dupla.
    # Combate fica ativo em HUNT, nif_fild01 e deslocamentos.
    setConfig('attackAuto', 2);

    for my $k (qw(
        sitAuto_hp_lower sitAuto_hp_upper sitAuto_sp_lower sitAuto_sp_upper
        sitAuto_follow sitAuto_over_50 sitAuto_idle sitTensionRelax followSitAuto
    )) {
        setConfig($k, 0);
    }

    $configApplied = 1;
}

sub restoreConfig {
    for my $k (keys %savedConfig) {
        if (defined $savedConfig{$k}) {
            $config{$k} = $savedConfig{$k};
        } else {
            delete $config{$k};
        }
    }
    %savedConfig = ();
}

sub coreBusy {
    return AI::inQueue(
        'NPC', 'storageAuto', 'transferItems', 'sellAuto', 'buyAuto'
    ) ? 1 : 0;
}

sub setHuntMode {
    $config{attackAuto} = 2;
}

sub setTravelMode {
    # Nunca desliga combate durante deslocamento.
    # O Knight deve limpar monstros no caminho em vez de arrasta-los.
    $config{attackAuto} = 2;
}

sub clearForwardMovement {
    # O leash cancela SOMENTE deslocamento.
    # Nunca limpa 'attack', portanto o Knight termina a luta atual.
    AI::clear(qw(route mapRoute move));
}

sub leashState {
    my ($pm) = @_;
    return ('MISSING', undef) unless $pm;

    my $pmap = memberMap($pm);
    return ('OTHER_MAP', undef)
        if $pmap ne '' && $pmap ne currentMap();

    my $pp = memberPos($pm);
    return ('MISSING', undef) unless $pp;

    my $me = $char->{pos_to} || $char->{pos};
    my $dist = blockDist($me, $pp);

    my $soft = int(cfg('nqKnight_leashSoft', 8));
    my $hard = int(cfg('nqKnight_leashHard', 12));
    $hard = $soft + 1 if $hard <= $soft;

    return ('NEAR', $dist) if $dist <= $soft;
    return ('SOFT', $dist) if $dist <= $hard;
    return ('FAR',  $dist);
}

sub enforcePriestLeash {
    my ($pm) = @_;
    my ($ls, $dist) = leashState($pm);

    # Priest perto: avanco normal para o setor.
    return 0 if $ls eq 'NEAR';

    # Priest ficou no mapa anterior.
    # Para a rota para frente imediatamente, mas attackAuto continua 2.
    if ($ls eq 'OTHER_MAP') {
        clearForwardMovement() if AI::inQueue('route', 'mapRoute', 'move');
        return 1;
    }

    # 9..12 celulas: nao abre mais distancia.
    # Para somente o deslocamento e continua matando o que aparecer.
    if ($ls eq 'SOFT') {
        clearForwardMovement() if AI::inQueue('route', 'mapRoute', 'move');
        return 1;
    }

    # >12: o Knight ja abriu distancia demais.
    # Cancela a rota para frente, termina a luta atual e volta
    # em direcao ao Priest MATANDO no caminho.
    if ($ls eq 'FAR') {
        clearForwardMovement() if AI::inQueue('route', 'mapRoute', 'move');

        # Nao interrompe combate em andamento.
        return 1 if AI::inQueue('attack');

        my $pp = memberPos($pm);
        if ($pp) {
            routeTo(
                currentMap(),
                $pp->{x}, $pp->{y},
                int(cfg('nqKnight_leashSoft', 8)),
                2
            );
        }
        return 1;
    }

    # Sem posicao confiavel: nao avanca cegamente.
    clearForwardMovement() if AI::inQueue('route', 'mapRoute', 'move');
    return 1;
}

sub routeTo {
    my ($map, $x, $y, $dist, $attackOnRoute) = @_;
    $dist = 3 unless defined $dist;
    $attackOnRoute = 0 unless defined $attackOnRoute;

    return if coreBusy();
    return if AI::inQueue('route', 'mapRoute', 'move');
    return if (time - $lastRoute) < cfg('nqKnight_routeCooldown', 0.7);

    ai_route(
        $map, $x, $y,
        attackOnRoute => $attackOnRoute,
        noSitAuto => 1,
        distFromGoal => $dist,
        isRandomWalk => 0,
    );

    $lastRoute = time;
}

sub setState {
    my ($new, $newPhase, $why) = @_;
    $newPhase //= 'RUN';

    return if $state eq $new && $phase eq $newPhase;

    message(
        "[nifQuestKnight] STATE $state/$phase -> $new/$newPhase"
        . (defined $why && $why ne '' ? " ($why)" : '')
        . "\n",
        'success'
    );

    $state = $new;
    $phase = $newPhase;

    if ($new eq 'QUEST_RETURN' || $new eq 'QUEST_PICKUP' || $new eq 'RECOVERY') {
        resetTransport();
    }

    resetDeadman() if $new ne 'QUEST_RETURN' && $new ne 'QUEST_PICKUP';
}

sub resumeNormal {
	
	# Se o HP emergency desligou teleportAuto_hp temporariamente,
    # reativa quando o ciclo terminou e a dupla vai voltar a caca.
    if (defined $hpEscapeRestoreHp) {
        $config{teleportAuto_hp} = $hpEscapeRestoreHp;

        message(
            "[nifQuestKnight] HP EMERGENCIA: teleportAuto_hp restaurado para "
            . $hpEscapeRestoreHp
            . "%.\n",
            'success'
        );

        undef $hpEscapeRestoreHp;
    }
	
	
    my $desired = pairDesiredState();

    if ($desired eq 'QUEST_RETURN') {
        setState('QUEST_RETURN', currentMap() eq npcMap() ? 'GO_DEADMAN' : 'GO_HOME', 'ambos complete');
        return;
    }

    if ($desired eq 'QUEST_PICKUP') {
        setState('QUEST_PICKUP', currentMap() eq npcMap() ? 'GO_DEADMAN' : 'GO_HOME', 'quest precisa sincronizar');
        return;
    }

    setState('HUNT', 'RUN', 'dupla pronta para caçar');
}

