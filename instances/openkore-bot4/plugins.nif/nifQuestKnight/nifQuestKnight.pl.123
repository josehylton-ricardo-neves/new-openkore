# entra e informa K_MAP com o mapa real em que caiu.
my $portalId=''; my $portalMode=''; my $portalX; my $portalY; my $portalAt=0; my $portalRouteStartedAt=0;
my $lastMapReport=0; my $portalEnterStartedAt=0;
my $pArrivedId=''; my $pArrivedMode=''; my $pArrivedMap='';

