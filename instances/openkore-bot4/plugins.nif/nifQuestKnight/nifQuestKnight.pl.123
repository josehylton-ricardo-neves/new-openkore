sub syncRetrySeconds { return cfg('nqKnight_syncRetry',2); }
sub transportTimeout { return cfg('nqKnight_transportSyncTimeout',18); }
sub resetPortalInfo {
    $portalId=''; $portalMode=''; undef $portalX; undef $portalY; $portalAt=0; $portalRouteStartedAt=0;
    $portalEnterStartedAt=0; $lastMapReport=0; $pArrivedId=''; $pArrivedMode=''; $pArrivedMap='';
}
sub sendReady {
    my ($mode)=@_; my $pos=$char->{pos_to}||$char->{pos}; return unless $pos;
    sendParty("K_READY $mode ".currentMap()." $pos->{x} $pos->{y}");
}
#sub sendCurrentMap {
#    my ($mode)=@_; return unless $portalId ne ''; my $pos=$char->{pos_to}||$char->{pos}; return unless $pos;
#    sendParty("K_MAP $portalId $mode ".currentMap()." $pos->{x} $pos->{y}"); $lastMapReport=time;
#}



sub sendCurrentMap {
    my ($mode) = @_;

    return 0 unless $portalId ne '';

    my $pos = $char->{pos_to} || $char->{pos};
    return 0 unless $pos;
    return 0 unless defined $pos->{x} && defined $pos->{y};

    sendParty(
        "K_MAP $portalId $mode "
        . currentMap()
        . " $pos->{x} $pos->{y}"
    );

    $lastMapReport = time;
    return 1;
}



sub sendHuntPosition {
    return unless $char && $field;

    my $pos = $char->{pos_to} || $char->{pos};
    return unless $pos;

    my $interval = cfg('nqKnight_huntPosHeartbeat', 2);

    return if $lastKPosSend
        && (time - $lastKPosSend) < $interval;

    sendParty(
        "K_POS "
        . currentMap()
        . " "
        . $pos->{x}
        . " "
        . $pos->{y}
    );

    $lastKPosSend = time;
}






# ------------------------------------------------------------
# EVENTOS: SOMENTE REGISTRAM
# ------------------------------------------------------------

sub onPartyMsg {
    my (undef,$args)=@_; return unless enabled() && $args;
    my $msg=$args->{Msg}//$args->{message}//''; my $user=$args->{MsgUser}//$args->{user}//'';
    return unless $msg =~ /^\[NQ\]\s+(.+)/i;
    my $expected=cfg('nqKnight_priestName','Curador'); return if $expected ne '' && $user ne '' && lc($user) ne lc($expected);
    my $m=$1;
    if ($m =~ /^STATUS\s+P\s+(inactive|incomplete|complete)$/i) { $peerQuest=lc($1); $peerQuestAt=time; return; }
    if ($m =~ /^P_PORTAL\s+(\S+)\s+(QUEST_RETURN|QUEST_PICKUP|RECOVERY)\s+(\d+)\s+(\d+)$/i) {
        my ($id,$mode,$x,$y)=($1,uc($2),int($3),int($4));
        my $isNew=($portalId ne $id)||!defined($portalX)||!defined($portalY)||$portalX!=$x||$portalY!=$y;
        if ($isNew) {
            $portalId=$id; $portalMode=$mode; $portalX=$x; $portalY=$y; $portalAt=time; $portalEnterStartedAt=time; $portalRouteStartedAt=0; $lastMapReport=0;
            clearForwardMovement() if AI::inQueue('route','mapRoute','move'); $lastRoute=0;
            if ($state eq $mode) { $phase='ENTER_PORTAL'; }
            message("[nifQuestKnight] PORTAL DISPONIVEL: id=$portalId mode=$portalMode coord=$portalX,$portalY.\n",'success');
        } else { $portalAt=time; }
        return;
    }
    if ($m =~ /^P_ARRIVED\s+(\S+)\s+(QUEST_RETURN|QUEST_PICKUP|RECOVERY)\s+(\S+)$/i) {
        $pArrivedId=$1; $pArrivedMode=uc($2); $pArrivedMap=normalizeMap($3); return;
    }
    
	#if ($m =~ /^P_DIED$/i) { $priestDiedAt=time; return; }
	
	
	if ($m =~ /^P_DIED$/i) {
    $priestDiedAt = time;

    # Confirma imediatamente que o Knight recebeu a morte.
    # Nao espera storage nem K_READY.
    sendParty('K_ACK_P_DIED');

    return;
	}
	
	
}

sub onStorageCompleted {
    return unless enabled();
    return unless $state eq 'QUEST_RETURN'
               || $state eq 'QUEST_PICKUP'
               || $state eq 'RECOVERY';

    $storageCompleted = 1;
    message("[nifQuestKnight] STORAGE: AI_storage_auto_completed recebido.\n", 'success');
}

# ------------------------------------------------------------
# HUNT
# ------------------------------------------------------------

sub aggressiveCount {
    my @ids;
    my $ok = eval { @ids = AI::ai_getAggressives(0, 1); 1; };
    return 0 unless $ok;
    return scalar @ids;
}











sub protectPriest {
    my ($PID, $pm) = @_;

    return 0 unless $PID && $pm;
    return 0 if memberDead($PID, $pm);

    # So funciona se os dois estiverem no mesmo mapa.
    my $pmap = memberMap($pm);
    return 0 if $pmap ne '' && $pmap ne currentMap();

    # Se ja esta atacando alguma coisa, nao interrompe a luta atual.
    return 0 if AI::inQueue('attack');

    my @attackers;

    my $ok = eval {
        @attackers = AI::ai_getMonstersAttacking($PID);
        1;
    };

    return 0 unless $ok;
    return 0 unless @attackers;

    my $me = $char->{pos_to} || $char->{pos};
    return 0 unless $me;

    my $maxDist = int(
        cfg('nqKnight_protectPriestDistance', 20)
    );

    my $bestID;
    my $bestMonster;
    my $bestDist;

    for my $ID (@attackers) {
        next unless $ID;

        my $monster = $monstersList
            ? $monstersList->getByID($ID)
            : undef;

        next unless $monster;

        my $mp = $monster->{pos_to} || $monster->{pos};
        next unless $mp;

        my $dist = blockDist($me, $mp);

        next if $dist > $maxDist;

        if (!defined $bestDist || $dist < $bestDist) {
            $bestID = $ID;
            $bestMonster = $monster;
            $bestDist = $dist;
        }
    }

    return 0 unless $bestID;

    # Defender o Priest tem prioridade sobre patrol/leash.
    AI::clear(qw(route mapRoute move));

    message(
        "[nifQuestKnight] PROTECT: "
        . ($bestMonster->{name} || 'Monster')
        . " esta atacando "
        . cfg('nqKnight_priestName', 'Curador')
        . " -> atacando agora"
        . " (dist=$bestDist).\n",
        'warning'
    );

    AI::attack($bestID);

    return 1;
}















