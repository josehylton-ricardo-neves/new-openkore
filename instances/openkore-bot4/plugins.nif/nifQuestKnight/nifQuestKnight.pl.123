sub processHunt {
    setHuntMode();

    if (!inNiflheimCorridor()) {
        setState('RECOVERY', 'GO_HOME', 'HUNT fora do corredor de Niflheim');
        return;
    }

    my ($PID, $pm) = priestMember();

    if ($pm && memberDead($PID, $pm)) {
        setState('RECOVERY', 'GO_HOME', 'Priest morreu');
        return;
    }
	
	
	
	
	# Fallback forte:
	# se o Priest estava conosco na caca e agora aparece no SAVE,
	# ele morreu/respawnou ou voltou para casa.
	# Em qualquer dos dois casos o Knight deve reagrupar.
	if ($pm) {
		my $pmap = memberMap($pm);

		if ($pmap eq saveMap()
			&& currentMap() ne saveMap()) {

			setState(
				'RECOVERY',
				'GO_HOME',
				'Priest voltou ao save'
			);

			return;
		}
	}
	
	
	

    my $desired = pairDesiredState();

    if ($desired eq 'QUEST_RETURN') {
        setState('QUEST_RETURN', 'GO_HOME', 'ambos complete');
        return;
    }

    if ($desired eq 'QUEST_PICKUP') {
        setState('QUEST_PICKUP', currentMap() eq npcMap() ? 'GO_DEADMAN' : 'GO_HOME', 'quest fora de sincronia');
        return;
    }

    if (aggressiveCount() >= int(cfg('nqKnight_emergencyAggressives', 6))) {
        setState('RECOVERY', 'GO_HOME', 'muitos agressivos');
        return;
    }
	
	#======================================PROVOKE======================================================
	# Protecao ativa do Priest.
	# Se algum monstro estiver atacando o Priest,
	# tenta puxar o aggro com Provoke.
	#return if protectPriestWithProvoke($PID, $pm);
	#===================================================================================================

    # Primeiro chega ao mapa de caça.
    if (currentMap() ne huntMap()) {
        setTravelMode();
        #routeTo(huntMap(), 68, 278, 6, 2);
		routeTo(huntMap(), 328, 318, 6, 2);
        return;
    }
	
	
	# Durante a caca, informa periodicamente onde o Knight esta.
	# Isto NAO faz parte da sincronizacao do Warp Portal.
	sendHuntPosition();
	
	
	# ------------------------------------------------------------
	# PROTECAO DO PRIEST TEM PRIORIDADE SOBRE LEASH/PATROL
	# ------------------------------------------------------------
	if ($pm && !memberDead($PID, $pm)) {
		return if protectPriest($PID, $pm);
	}

	

    # Leash ativo: Knight lidera, mas nao abandona o Priest.
    # A rota para frente e interrompida assim que o Priest fica para tras;
    # o combate permanece ativo o tempo inteiro.
    if ($pm && !memberDead($PID, $pm)) {
        return if enforcePriestLeash($pm);
    } else {
        clearForwardMovement() if AI::inQueue('route', 'mapRoute', 'move');
        return;
    }

    return if AI::inQueue('attack', 'route', 'mapRoute', 'move');

    my @p = patrolPoints();
    $patrolIndex = 0 if $patrolIndex > $#p;
    my ($x, $y) = @{$p[$patrolIndex]};

    my $me = $char->{pos_to} || $char->{pos};
    if ($me && blockDist($me, {x=>$x,y=>$y}) <= 6) {
        $patrolIndex++;
        $patrolIndex = 0 if $patrolIndex > $#p;
        ($x, $y) = @{$p[$patrolIndex]};
    }

    return if (time - $lastPatrolRoute) < 0.7;

    ai_route(
        huntMap(), $x, $y,
        attackOnRoute => 2,
        noSitAuto => 1,
        distFromGoal => 6,
        isRandomWalk => 0,
    );
    $lastPatrolRoute = time;
}

# ------------------------------------------------------------
# STORAGE / BUTTERFLY / TRANSPORTE
# ------------------------------------------------------------

sub resetStorage {
    $storageStarted = 0;
    $storageCompleted = 0;
}

sub processStorage {
    return 1 if $storageCompleted && !coreBusy();

    if (!$storageStarted) {
        if (AI::inQueue('storageAuto', 'NPC', 'transferItems', 'sellAuto', 'buyAuto')) {
            $storageStarted = 1;
            return 0;
        }

        if (!cfg('nqKnight_storageOnReturn', 1)) {
            $storageCompleted = 1;
            return 1;
        }

        message("[nifQuestKnight] STORAGE: iniciando autostorage UMA vez.\n", 'info');
        Commands::run('autostorage');
        $storageStarted = 1;
        return 0;
    }

    return 0;
}

sub useButterfly {
    return 0 if currentMap() eq saveMap();
    return 0 unless $char && $char->inventory && $char->inventory->isReady();
    return 0 if (time - $lastButterfly) < 3;

    my $item = $char->inventory->getByNameID(602);
    $item ||= $char->inventory->getByName('Butterfly Wing');

    unless ($item && ($item->{amount} || 0) > 0) {
        error "[nifQuestKnight] Sem Butterfly Wing.\n";
        $lastButterfly = time;
        return 0;
    }

    setTravelMode();
    AI::clear(qw(attack route mapRoute move));
    $item->use();
    $lastButterfly = time;
    return 1;
}

sub resetTransport { resetStorage(); resetPortalInfo(); $lastProtocolSend=0; }

sub hpPercent {
    return 0 unless $char && ($char->{hp_max} || 0) > 0;
    return int(($char->{hp} || 0) * 100 / $char->{hp_max});
}






sub onMapChanged {
    return unless $hpEscapePending;

    # O teleportAuto realmente foi confirmado pelo servidor.
    $hpEscapeTeleported = 1;

    message(
        "[nifQuestKnight] HP EMERGENCIA: teleport/Fly Wing confirmado; "
        . "liberando retorno por Butterfly Wing.\n",
        'success'
    );
}

sub processEmergencyHpEscape {
    return 0 if $char->{dead};

    # So aplica durante a caca normal.
    return 0 unless $state eq 'HUNT';

    my $limit = int($config{teleportAuto_hp} || 0);
    return 0 if $limit <= 0;

    # HP ainda normal.
    if (!$hpEscapePending) {
        return 0 if hpPercent() > $limit;

        $hpEscapePending = 1;
        $hpEscapeTeleported = 0;
        $hpEscapeStartedAt = time;
        $hpEscapeRestoreHp = $limit;

        # Para ataque/movimento para o teleportAuto ter prioridade.
        # Nao limpa a task "teleport".
        AI::clear(qw(attack route mapRoute move));

        warning(
            "[nifQuestKnight] HP EMERGENCIA: "
            . hpPercent()
            . "% <= ${limit}%. "
            . "Aguardando teleportAuto/Fly Wing antes da Butterfly.\n"
        );

        return 1;
    }

    # Ainda esperando o Fly Wing/Teleport ser confirmado.
    if (!$hpEscapeTeleported) {
        AI::clear(qw(attack route mapRoute move));
        return 1;
    }

    # Fly Wing ja aconteceu.
    # Impede teleportAuto_hp de disparar varios Fly Wings seguidos.
    $config{teleportAuto_hp} = 0;

    $hpEscapePending = 0;
    $hpEscapeTeleported = 0;
    $hpEscapeStartedAt = 0;

    setState(
        'RECOVERY',
        'GO_HOME',
        'teleport de emergencia concluido'
    );

    return 1;
}






sub priestAliveAtSave {
    my ($PID, $pm) = priestMember();
    return 0 unless $pm;
    return 0 if memberDead($PID, $pm);
    return memberMap($pm) eq saveMap() ? 1 : 0;
}

sub processDeadWait {
    # Knight morreu: NAO espera Resurrection.
    # Volta imediatamente ao save point e reinicia o ciclo.
    if ($char->{dead}) {
        if ((time - $lastDeadSend) >= 1) {
            my $p = $char->{pos_to} || $char->{pos};

            if ($p) {
                sendParty(
                    "K_DEAD "
                    . currentMap()
                    . " $p->{x} $p->{y}"
                );
            }

            $lastDeadSend = time;
        }

        message(
            "[nifQuestKnight] MORTE: respawn imediato no save; sem esperar Resurrection.\n",
            'warning'
        );

        Commands::run('respawn');

        $deadSince = 0;
        $phase = 'GO_HOME';
        return;
    }

    # Segurança caso o servidor já tenha confirmado o respawn.
    $deadSince = 0;
    $phase = 'GO_HOME';
}

sub processTransport {
    my ($mode)=@_; setTravelMode();
    if ($char->{dead}) { $phase='DEAD_WAIT'; }
    if ($phase eq 'DEAD_WAIT') { processDeadWait(); return; }
    if ($phase eq 'GO_HOME') {
        if (currentMap() ne saveMap()) { useButterfly(); return; }
        resetStorage(); resetPortalInfo(); $phase='STORAGE'; message("[nifQuestKnight] $mode: chegou ao save -> STORAGE.\n",'info'); return;
    }
    if ($phase eq 'STORAGE') { return unless processStorage(); $phase='WAIT_PORTAL'; message("[nifQuestKnight] $mode: storage concluido -> WAIT_PORTAL.\n",'success'); return; }
    if ($phase eq 'WAIT_PORTAL') {
        my $minHP=int(cfg('nqKnight_readyMinHPPercent',90)); return if hpPercent()<$minHP;
        if ((time-$lastProtocolSend)>=syncRetrySeconds()) { sendReady($mode); $lastProtocolSend=time; }
        return;
    }
    if ($phase eq 'ENTER_PORTAL') {
        if (currentMap() ne saveMap()) {
            sendCurrentMap($mode) if (time-$lastMapReport)>=syncRetrySeconds();
            if (currentMap() eq npcMap()) { $phase='WAIT_PRIEST'; } else { $phase='WAIT_RESYNC'; }
            return;
        }
        return unless $portalId ne '' && $portalMode eq $mode && defined $portalX && defined $portalY;
        if ($portalEnterStartedAt && (time-$portalEnterStartedAt)>=transportTimeout()) {
            my $pos=$char->{pos_to}||$char->{pos}; if($pos){sendParty("K_RESYNC $portalId $mode ".currentMap()." $pos->{x} $pos->{y}");}
            warning("[nifQuestKnight] SYNC EXPIRADO: nao atravessei portalId=$portalId em ".transportTimeout()."s. Aguardando NOVO id.\n");
            resetPortalInfo(); $phase='WAIT_PORTAL'; $lastProtocolSend=0; return;
        }
        if (!AI::inQueue('route','mapRoute','move')) {
            message("[nifQuestKnight] $mode: indo para portalId=$portalId em $portalX,$portalY.\n",'info');
            $lastRoute=0; routeTo(saveMap(),$portalX,$portalY,0,0); $portalRouteStartedAt=time;
        }
        return;
    }
    if ($phase eq 'WAIT_PRIEST') {
        sendCurrentMap($mode) if (time-$lastMapReport)>=syncRetrySeconds();
        if ($pArrivedId eq $portalId && $pArrivedMode eq $mode && $pArrivedMap eq npcMap()) {
            message("[nifQuestKnight] TRANSPORTE CONCLUIDO: Priest confirmou ".npcMap()." para portalId=$portalId.\n",'success');
            resetPortalInfo(); if($mode eq 'RECOVERY'){resumeNormal();}else{$phase='GO_DEADMAN';}
        }
        return;
    }
    if ($phase eq 'WAIT_RESYNC') {
        sendCurrentMap($mode) if (time-$lastMapReport)>=syncRetrySeconds();
        if (currentMap() ne saveMap()) { useButterfly(); return; }
        my $oldId=$portalId; resetPortalInfo();
        warning("[nifQuestKnight] RESYNC: voltei ao save; portalId=$oldId descartado. Aguardando NOVO portalId.\n");
        $phase='WAIT_PORTAL'; $lastProtocolSend=0; return;
    }
}

# ------------------------------------------------------------
# DEADMAN / QUEST
# ------------------------------------------------------------

sub findDeadman {
    return unless currentMap() eq npcMap() && $npcsList;

    my $name = cfg('nqKnight_npcName', 'Deadman');
    my $tx = int(cfg('nqKnight_npcX', 332));
    my $ty = int(cfg('nqKnight_npcY', 327));

    my @npcs = @{$npcsList->getItems()};

    for my $n (@npcs) {
        next unless $n && defined $n->{name};
        return $n if lc($n->{name}) eq lc($name);
    }

    my ($best, $bd) = (undef, 99999);
    for my $n (@npcs) {
        next unless $n;
        my $p = $n->{pos} || $n->{pos_to};
        next unless $p;
        my $d = blockDist($p, {x=>$tx, y=>$ty});
        if ($d < $bd && $d <= 6) {
            $best = $n;
            $bd = $d;
        }
    }

    return $best;
}

sub resetDeadman {
    $deadmanActive = 0;
    $deadmanMode = '';
    $deadmanStage = 0;
    $deadmanStartedAt = 0;
}

sub normalizeOption {
    my ($s) = @_;
    $s //= '';
    $s =~ s/\^[0-9A-Fa-f]{6}//g;
    $s =~ s/^\s+|\s+$//g;
    $s =~ s/\s+/ /g;
    return $s;
}

sub choosePickupResponse {
    my ($responses) = @_;
    return unless $responses && ref($responses) eq 'ARRAY';

    my @o = map { normalizeOption($_) } @$responses;

    #for my $i (0..$#o) {
    #    return $i if $o[$i] =~ /Loli\s*Ruri/i;
    #}
	
	for my $i (0..$#o) {
		return $i if $o[$i] =~ /^Disguise$/i;
	}

    for my $i (0..$#o) {
        return $i if $o[$i] =~ /^Sure$/i;
    }

    return 0 if $deadmanStage == 0 && $#o >= 1;
    return 1 if $deadmanStage >= 1 && $#o >= 2;

    return;
}

sub startDeadman {
    my ($mode) = @_;

    return 0 if $deadmanActive;
    return 0 if coreBusy();
    return 0 if %talk;
    return 0 if (time - $lastDeadmanTalk) < 1;

    my $npc = findDeadman();
    return 0 unless $npc;

    setTravelMode();

    $deadmanActive = 1;
    $deadmanMode = $mode;
    $deadmanStage = 0;
    $deadmanStartedAt = time;
    $lastDeadmanTalk = time;

    eval { $npc->sendTalk; 1 } or do {
        resetDeadman();
        return 0;
    };

    message("[nifQuestKnight] DEADMAN: iniciando $mode.\n", 'info');
    return 1;
}

sub onDeadmanTalkContinue {
    return unless $deadmanActive;
    return unless %talk && defined $talk{ID};
    eval { $messageSender->sendTalkContinue($talk{ID}); };
}

sub onDeadmanTalkResponses {
    my (undef, $args) = @_;
    return unless $deadmanActive;
    return unless %talk && defined $talk{ID};

    my $responses =
        ($args && ref($args) eq 'HASH' && ref($args->{responses}) eq 'ARRAY')
            ? $args->{responses}
            : $talk{responses};

    return unless $responses && ref($responses) eq 'ARRAY';

    if ($deadmanMode eq 'turnin') {
        eval { $messageSender->sendTalkCancel($talk{ID}); };
        resetDeadman();
        return;
    }

    my $idx = choosePickupResponse($responses);
    unless (defined $idx && $idx < $#$responses) {
        eval { $messageSender->sendTalkCancel($talk{ID}); };
        resetDeadman();
        return;
    }

    eval { $messageSender->sendTalkResponse($talk{ID}, $idx + 1); };
    $deadmanStage++;
}

sub onDeadmanTalkDone {
    return unless $deadmanActive;
    my $mode = $deadmanMode;
    resetDeadman();
    $lastDeadmanTalk = time;

    message(
        "[nifQuestKnight] DEADMAN: $mode terminou; quest=" . questStatus() . ".\n",
        'info'
    );
}

sub goDeadman {
    return 0 unless currentMap() eq npcMap();

    my $npc = findDeadman();
    my $target = $npc ? ($npc->{pos} || $npc->{pos_to}) : undef;

    $target ||= {
        x => int(cfg('nqKnight_npcX', 332)),
        y => int(cfg('nqKnight_npcY', 327)),
    };

    my $me = $char->{pos_to} || $char->{pos};

    if (blockDist($me, $target) > 4) {
        setTravelMode();
        routeTo(npcMap(), $target->{x}, $target->{y}, 4, 2);
        return 0;
    }

    return 1;
}

sub processQuestReturn {
    if ($phase =~ /^(GO_HOME|STORAGE|WAIT_PORTAL|ENTER_PORTAL|WAIT_PRIEST|WAIT_RESYNC|DEAD_WAIT)$/) {
        processTransport('QUEST_RETURN');
        return;
    }

    if ($phase eq 'GO_DEADMAN') {
        return unless goDeadman();
        $phase = 'TURNIN';
        return;
    }

    if ($phase eq 'TURNIN') {
        my $own = questStatus();

        if ($own eq 'complete') {
            startDeadman('turnin');
            return;
        }

        if ($own eq 'inactive' || pairDesiredState() eq 'QUEST_PICKUP') {
            setState('QUEST_PICKUP', 'GO_DEADMAN', 'turn-in avancou');
            return;
        }

        if ($own eq 'incomplete') {
            resumeNormal();
        }
    }
}

sub processQuestPickup {
    if (currentMap() ne npcMap()
        || $phase =~ /^(GO_HOME|STORAGE|WAIT_PORTAL|ENTER_PORTAL|WAIT_PRIEST|WAIT_RESYNC|DEAD_WAIT)$/) {
        if ($phase eq 'GO_DEADMAN' && currentMap() ne npcMap()) {
            $phase = 'GO_HOME';
            resetTransport();
        }
        processTransport('QUEST_PICKUP');
        return;
    }

    if ($phase eq 'GO_DEADMAN') {
        return unless goDeadman();
        $phase = 'SYNC';
        return;
    }

    if ($phase eq 'SYNC') {
        my $own = questStatus();
        my $peer = peerQuest();

        if ($own eq 'complete') {
            startDeadman('turnin');
            return;
        }

        if ($own eq 'inactive') {
            startDeadman('pickup');
            return;
        }

        if ($own eq 'incomplete' && $peer eq 'incomplete') {
            setState('HUNT', 'RUN', 'ambos incomplete');
            return;
        }

        return;
    }
}

# ------------------------------------------------------------
# RECOVERY
# ------------------------------------------------------------

sub processRecovery {
    processTransport('RECOVERY');
}

# ------------------------------------------------------------
# AI
# ------------------------------------------------------------

sub onAIPre {
    return unless enabled();
    applyBaseConfig();

    if ($char && $char->{sitting}) {
        eval { AI::stand(); };
    }
}

sub onAI {
    return unless enabled();
    return unless $char && $field;

    my $now = time;
    return if ($now - $lastTick) < 0.20;
    $lastTick = $now;

    applyBaseConfig();

    # Kafra/NPC/storage tem prioridade absoluta.
    return if coreBusy();

    broadcastStatus(0);

    # Excecoes globais antes do dispatcher.
    if ($char->{dead} && $state ne 'RECOVERY') {
        $deadSince ||= time;
        setState('RECOVERY', 'DEAD_WAIT', 'Knight morreu');
        return;
    }
	
	
	
	# HP critico:
	# deixa teleportAuto executar o Fly Wing primeiro.
	# Depois do Map Change inicia o RECOVERY/Butterfly.
	if (processEmergencyHpEscape()) {
		return;
	}
	
	

    if ($state ne 'RECOVERY'
        && $priestDiedAt
        && (time - $priestDiedAt) <= 8) {
        setState('RECOVERY', 'GO_HOME', 'P_DIED recebido');
        return;
    }

    if ($state eq 'HUNT') {
        processHunt();
        return;
    }

    if ($state eq 'QUEST_RETURN') {
        processQuestReturn();
        return;
    }

    if ($state eq 'QUEST_PICKUP') {
        processQuestPickup();
        return;
    }

    if ($state eq 'RECOVERY') {
        processRecovery();
        return;
    }

    setState('HUNT', 'RUN', 'estado invalido');
}

# ------------------------------------------------------------
# COMMAND
# ------------------------------------------------------------

sub cmdNQK {
    my (undef, $args) = @_;
    $args //= '';
    $args =~ s/^\s+|\s+$//g;

    if ($args eq '' || $args eq 'status') {
        my $age = $peerQuestAt ? sprintf('%.1f', time - $peerQuestAt) : '-';
        message("nifQuestKnight v$VERSION\n", 'list');
        message("state=$state phase=$phase\n", 'list');
        message("map=" . currentMap() . "\n", 'list');
        message("quest=" . questStatus() . " peer=" . peerQuest() . " peerAge=$age\n", 'list');
        message("storageStarted=$storageStarted storageCompleted=$storageCompleted\n", 'list');
        message(
            "portalId=" . ($portalId || '-')
            . " portalMode=" . ($portalMode || '-')
            . " portal=" . (defined $portalX ? "$portalX,$portalY" : '-')
            . " portalAge=" . ($portalAt ? sprintf('%.1f',time-$portalAt) : '-')
            . " P_ARRIVED=" . ($pArrivedMap || '-')
            . "\n", 'list'
        );
        my ($PID, $pm) = priestMember();
        my ($ls, $ld) = leashState($pm);
        message(
            "HP=" . hpPercent()
            . "% patrolIndex=$patrolIndex"
            . " leash=$ls"
            . " dist=" . (defined $ld ? $ld : '-')
            . " attackAuto=" . ($config{attackAuto} // '-')
            . "\n",
            'list'
        );
        return;
    }

    if ($args eq 'version') {
        message("$VERSION\n", 'list');
        return;
    }

    if ($args eq 'hunt') {
        setState('HUNT', 'RUN', 'comando');
        return;
    }

    if ($args eq 'recovery') {
        setState('RECOVERY', $char->{dead} ? 'DEAD_WAIT' : 'GO_HOME', 'comando');
        return;
    }

    if ($args eq 'return') {
        setState('QUEST_RETURN', 'GO_HOME', 'comando');
        return;
    }

    if ($args eq 'pickup') {
        setState('QUEST_PICKUP', currentMap() eq npcMap() ? 'GO_DEADMAN' : 'GO_HOME', 'comando');
        return;
    }

    message("Uso: nqk status | version | hunt | recovery | return | pickup\n", 'list');
}

sub onUnload {
    restoreConfig();
    Commands::unregister($commands) if $commands;
    Plugins::delHooks($hooks) if $hooks;
}

1;
